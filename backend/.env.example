# JWT Secret Key (32자 이상 랜덤 문자열)
JWT_SECRET=your-very-long-random-secret-key-at-least-32-chars

# Finnhub API Key
# https://finnhub.io/ 에서 무료 가입 후 발급
FINNHUB_API_KEY=your_finnhub_api_key_here

# 한국투자증권 API Key (실전투자)
# https://apiportal.koreainvestment.com/ 에서 앱 등록 후 발급
KIS_APP_KEY=your_kis_app_key_here
KIS_APP_SECRET=your_kis_app_secret_here

# Anthropic Claude API Key (Ver5 AI 브리핑)
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# 네이버 뉴스 검색 API (Ver6 RAG — KR 종목 뉴스 수집)
# https://developers.naver.com/apps/#/register 에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# OpenAI Embeddings API (Ver6 RAG — 뉴스 임베딩)
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=sk-your-openai-api-key-here
